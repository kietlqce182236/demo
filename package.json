{
  "name": "kids-nutri-journal-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "KidsNutriJournal - Hệ thống Quản lý Dinh dưỡng và Bữa ăn Bán trú tại Trường Mầm non",
  "scripts": {
    "dev:backend": "pnpm --filter @kidsnutri/backend dev",
    "dev:frontend": "pnpm --filter @kidsnutri/frontend dev",
    "build": "pnpm --filter \"@kidsnutri/*\" build",
    "lint": "pnpm --filter \"@kidsnutri/*\" lint",
    "test": "npm --prefix apps/backend run test",
    "test:unit": "npm --prefix apps/backend run test",
    "test:api": "npm --prefix apps/backend run test:e2e",
    "test:all": "npm --prefix apps/backend run test && npm --prefix apps/backend run test:e2e",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:verify": "node database/verify_schema.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "bcrypt",
      "esbuild"
    ]
  }
}
